---
interface Props {
  active?: string;
}
const { active = '' } = Astro.props;
const items = [
  { href: '/notebook', label: 'Notebook', key: 'notebook' },
  { href: '/home', label: 'Photography', key: 'photography' },
  { href: '/films', label: 'Films', key: 'films' },
  { href: 'https://www.damkind.xyz/', label: 'Podcast', key: 'podcast', external: true },
  { href: '/about', label: 'About', key: 'about' },
];
---
<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="wordmark">BC</a>
    <button class="nav-toggle" type="button" aria-label="Menu" aria-controls="site-nav" aria-expanded="false" id="nav-toggle">Menu</button>
    <nav class="nav" id="site-nav">
      {items.map((item) => (
        item.external ? (
          <a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a>
        ) : (
          <a
            href={item.href}
            class={active === item.key ? 'active' : undefined}
            aria-current={active === item.key ? 'page' : undefined}
          >{item.label}</a>
        )
      ))}
    </nav>
  </div>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');

  function setOpen(open: boolean) {
    nav?.classList.toggle('open', open);
    btn?.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (btn) btn.textContent = open ? 'Close' : 'Menu';
  }

  btn?.addEventListener('click', () => setOpen(!nav?.classList.contains('open')));
  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
