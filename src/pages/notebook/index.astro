---
import Layout from '../../layouts/Layout.astro';

const posts: { href: string; title: string; tags: string; photography?: string }[] = [
  { href: '/notebook/2023--you-made-it-part-ii', title: '2023 -You Made It (Part II)', tags: '#2023' },
  { href: '/notebook/godparent-11-11', title: 'Godparent 11/11', tags: '#children #journal' },
  { href: '/notebook/nuance-of-experience', title: 'Nuance of Experience', tags: '#personal #research', photography: 'nuance-of-experience' },
  { href: '/notebook/are-you-doing-right-by-you', title: 'Are you doing right by you?', tags: '#note' },
  { href: '/notebook/the-push', title: 'The push', tags: '#note' },
  { href: '/notebook/reassurance-is-futile', title: 'Reassurance is futile', tags: '#note' },
  { href: '/notebook/ready-when-youre-ready', title: "Ready when you're ready", tags: '#note' },
  { href: '/notebook/newlyborn', title: 'Newlyborn', tags: '#note' },
  { href: '/notebook/look-for-the-looker', title: 'Look for the looker', tags: '#note' },
  { href: '/notebook/light-of-late', title: 'Light of late', tags: '#note' },
  { href: '/notebook/freelance', title: 'Freelance', tags: '#note' },
  { href: '/notebook/alcohol-free', title: 'Alcohol free', tags: '#note' },
  { href: '/notebook/accept-suffering', title: 'Accept suffering', tags: '#note' },
  { href: '/notebook/reprogramme-your-run', title: 'Reprogramme Your Run', tags: '#note' },
  { href: '/notebook/what-is-research', title: 'What is Research?', tags: '#presentation' },
];
---
<Layout title="words" active="notebook">
  <section class="page-head">
    <h1>Notebook</h1>
    <p class="lede">Notes, write-ups, and points of view. From the smallest observation to writing that sits next to photographs.</p>
  </section>
  <div class="note-list">
    {posts.map((p) => (
      <a class="note-item" href={p.href}>
        <span class="note-title">{p.title}</span>
        <span class="tags">{p.tags}</span>
        {p.photography && <span class="note-companion">Also in Photography</span>}
      </a>
    ))}
  </div>
</Layout>
