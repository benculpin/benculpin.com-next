---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Ben Culpin" active="home">
  <header class="home-hero" id="hero">
    <div class="home-hero-copy">
      <h1>Hi, I'm Ben.</h1>
      <p class="sub">Considered listener, creative thinker.</p>
      <a class="btn" href="/about">Learn more</a>
      <ul class="home-links">
        <li><a href="/notebook">Notebook</a></li>
        <li><a href="/films">Films</a></li>
        <li><a href="/home">Photography</a></li>
      </ul>
    </div>
    <img
      class="hero-photo"
      src="/images/hero-portrait.jpg"
      alt="Portrait of Ben Culpin"
      width="1024"
      height="1280"
    />
  </header>
</Layout>
