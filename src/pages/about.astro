---
import Layout from '../layouts/Layout.astro';

const research = [
  { title: 'Discussion Guides', body: 'Design a dialogue that flows, opens people up, and keeps you on track and free to explore.', img: '/images/about/discussion-guides.jpg' },
  { title: 'Interviews', body: "Talk to people in a way where they reveal truths they didn't even know they had.", img: '/images/about/interviews.jpg' },
  { title: 'Deep Dive Immersions', body: 'Go out into the world and experience the life of the people you serve or dedicate time to.', img: '/images/about/immersions.jpg' },
  { title: 'Film & Photography', body: 'Capture visual artefacts from time spent doing research in the field.', img: '/images/about/film-photo.jpg' },
  { title: 'Desk Research', body: 'Complement your efforts "out there" with smart investigation online and elsewhere.', img: '/images/about/desk-research.jpg' },
  { title: 'Reporting', body: 'Play back what you did and discovered, and do it in a way that moves people.', img: '/images/about/reporting.jpg' },
];

const strategy = [
  { title: 'Creative Briefs', body: 'Make a jump on where to go next, who with, and in what manner.', img: '/images/about/creative-briefs.jpg' },
  { title: 'People Profiling', body: 'Peel back and reveal your audience, user, customer, or consumer. People.', img: '/images/about/people-profiling.jpg' },
  { title: 'Brand Positionings', body: 'Establish strongly justified and creative ways forward for your brand.', img: '/images/about/brand-positionings.jpg' },
  { title: 'Manifestos', body: 'Lay down some poetry to rally your peoples.', img: '/images/about/manifestos.jpg' },
  { title: 'Naming & Taglines', body: 'Reinvent or start from zero, decide on what you are called, and how you call upon others.', img: '/images/about/taglines.jpg' },
  { title: 'Brand Books', body: 'Put all the rules together in one wonderful place for you and your team to live by.', img: '/images/about/brand-books.jpg' },
  { title: 'Cultural Alignment', body: 'Make sure everyone is on board, invested personally, and working towards the same goal.', img: '/images/about/cultural-alignment.jpg' },
  { title: 'Presentations', body: 'Pitch or play back everything that really matters.', img: '/images/about/presentations.jpg' },
  { title: 'Visual Strategic Stories', body: 'Tell stories that travel with words, photography, and film.', img: '/images/about/visual-stories.jpg' },
];

const logos = [
  { src: '/images/about/logo-nike.png', alt: 'Nike' },
  { src: '/images/about/logo-huawei.png', alt: 'Huawei' },
  { src: '/images/about/logo-tesla.png', alt: 'Tesla' },
  { src: '/images/about/logo-emirates.png', alt: 'Emirates' },
  { src: '/images/about/logo-idh.jpeg', alt: 'IDH' },
  { src: '/images/about/logo-vans.png', alt: 'Vans' },
];

const teams = [
  { title: 'Building a Practice', body: 'Shape a team of researchers around a shared craft and a point of view worth defending.' },
  { title: 'Coaching', body: 'Help researchers find their own voice, give them room to run, and stand close enough to catch them.' },
  { title: 'A Place to Belong', body: 'Make a team feel like home. Somewhere people are taken care of, safe to put up a hand and ask for help, and just as safe to jump straight in.' },
  { title: 'Rituals & Rhythms', body: "Build the systems, rituals, and rhythms that keep a team honest, curious, and generative, always building on each other's ideas. I don't love saying no, so I build systems that say it kindly for me." },
];

const technology = [
  { title: 'AI-Augmented Research', body: 'Hand the heavy lifting to the machines so there is more time for the parts that matter: the head and the heart.' },
  { title: 'Tooling the Craft', body: 'Build tools, personal and team-wide, that hold on to what matters, so we can be fully present for the moment in front of us.' },
  { title: 'Synthesis at Scale', body: 'Help a whole team move through mountains of data, transcripts, dashboards, field notes, without losing the goose-bump moments buried inside them.' },
  { title: 'Human Judgement', body: 'Know where the machine stops and the human begins. Taste, empathy, and the room still belong to us. For now.' },
];
---
<Layout
  title="About"
  active="about"
  description="Researcher, strategist, and documentarian. Head of Research at DEPT in Amsterdam."
  image="/images/about/profile.jpg"
>
  <section class="page-head" id="about-top">
    <h1>About</h1>
    <p>
      I am a researcher, strategist, and documentarian. A considered listener and creative thinker. These days I'm also Head of Research at DEPT® in Amsterdam.
    </p>
  </section>

  <section class="feature" id="feature-section">
    <img src="/images/about/profile.jpg" alt="Ben Culpin seated in an armchair" />
    <div>
      <h2>Heart-felt perspective</h2>
      <p>
        My disciplines centre around an innate need for perspective, a sensitivity to the world, and a desire to be kind to myself and others. I seek the heart-felt perspective.
      </p>
      <div class="btn-row">
        <a class="btn" href="#my-roots">Read on</a>
      </div>
    </div>
  </section>

  <section class="quote-logos">
    <div class="quote-logos-inner">
      <div class="quote-card">
        <p class="q">“He's one of our favourites! We love working with him and looking forward to a continued collaboration!”</p>
        <div class="quote-who">
          <img src="/images/about/jason.jpg" alt="Jason Fulton" />
          <div>Jason Fulton<br />This Memento - Amsterdam</div>
        </div>
      </div>
      <div class="logo-grid">
        {logos.map((l) => <img src={l.src} alt={l.alt} />)}
      </div>
    </div>
  </section>

  <section class="about-block" id="my-roots">
    <h2>My Roots</h2>
    <p>
      Ethnographic research and brand strategy. One is the immersive soak, the other the sharpest articulation. I take it all in, let it stew, then make the jump. It's what considered listener, creative thinker looks like in practice.
    </p>
  </section>

  <section class="cards-section" id="research-services">
    <h2>Research</h2>
    <div class="cards">
      {research.map((c) => (
        <div>
          <img src={c.img} alt="" />
          <h3>{c.title}</h3>
          <p>{c.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="cards-section" id="strategy-services">
    <h2>Strategy</h2>
    <div class="cards">
      {strategy.map((c) => (
        <div>
          <img src={c.img} alt="" />
          <h3>{c.title}</h3>
          <p>{c.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="about-block">
    <p>
      Much of it gets captured along the way. See <a href="/photography">Photography</a>. See <a href="/film">Film</a>.
    </p>
  </section>

  <section class="about-block field-notes">
    <h2>Field Notes</h2>
    <ul>
      <li>Ask the question, then take a breath. If nothing comes, take another. The truest things arrive in the second silence.</li>
      <li>Walk into every room assuming you know nothing. The obvious question is usually the brave one.</li>
      <li>I'm not a systems person. I build systems so I can stay a people person.</li>
      <li>If no one was moved, it isn't finished. That goes for the research, the strategy, and the team.</li>
    </ul>
  </section>

  <section class="about-block frontiers">
    <h2>My Frontiers</h2>
    <p>
      I lead a research team now, with machines in the toolkit. My conviction hasn't moved. In a world ever more weighted towards data, we have to keep grounding ourselves in the real. Data meets reality. People first, always.
    </p>
    <h3>Teams</h3>
    <div class="frontier-grid">
      {teams.map((c) => (
        <div class="frontier-card">
          <h4>{c.title}</h4>
          <p>{c.body}</p>
        </div>
      ))}
    </div>
    <h3>Technology</h3>
    <div class="frontier-grid">
      {technology.map((c) => (
        <div class="frontier-card">
          <h4>{c.title}</h4>
          <p>{c.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="about-block now">
    <h2>Now</h2>
    <p>
      Currently rebuilding this website. Slowly making a home, which I'm counting as a creative project. Spending less time on the feeds and more in places I can own, free of the mechanics that have started to feel heavy. The photography will live here, for the people who actually care.
    </p>
  </section>

  <section class="about-block about-close">
    <h2>Does the spirit move you?</h2>
    <p>
      No forms here anymore. Write me at <a href="mailto:benculpin@gmail.com">benculpin@gmail.com</a> or find me on <a href="https://www.linkedin.com/in/benculpin/">LinkedIn</a>. I read everything.
    </p>
  </section>
</Layout>
