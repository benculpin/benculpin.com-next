---
import Layout from '../../layouts/Layout.astro';
import Lightbox from '../../components/Lightbox.astro';
import { collections, type Collection } from '../../data/photography';

export function getStaticPaths() {
  return collections.map((collection) => ({
    params: { slug: collection.slug },
    props: { collection },
  }));
}

interface Props {
  collection: Collection;
}

const { collection } = Astro.props;
const intro = collection.intro ?? collection.lede;
const notebookHref = collection.notebook ? `/notebook/${collection.notebook}` : undefined;

type StoryRow = { kind: 'full' | 'pair' | 'bleed'; files: string[] };

const TAIWAN_STORY: StoryRow[] = [
  { kind: 'bleed', files: ['03.jpg'] },
  { kind: 'pair', files: ['01.jpg', '02.jpg'] },
  { kind: 'pair', files: ['04.jpg', '07.jpg'] },
  { kind: 'pair', files: ['05.jpg', '06.jpg'] },
  { kind: 'pair', files: ['08.jpg', '13.jpg'] },
  { kind: 'bleed', files: ['09.jpg'] },
  { kind: 'pair', files: ['10.jpg', '11.jpg'] },
  { kind: 'full', files: ['12.jpg'] },
  { kind: 'pair', files: ['14.jpg', '19.jpg'] },
  { kind: 'full', files: ['16.jpg'] },
  { kind: 'pair', files: ['15.jpg', '17.jpg'] },
  { kind: 'full', files: ['22.jpg'] },
  { kind: 'bleed', files: ['23.jpg'] },
  { kind: 'full', files: ['18.jpg'] },
  { kind: 'pair', files: ['20.jpg', '21.jpg'] },
];

const PHILIPPINES_STORY: StoryRow[] = [
  { kind: 'bleed', files: ['05.jpg'] },
  { kind: 'pair', files: ['01.jpg', '02.jpg'] },
  { kind: 'pair', files: ['04.jpg', '09.jpg'] },
  { kind: 'pair', files: ['03.jpg', '07.jpg'] },
  { kind: 'pair', files: ['06.jpg', '08.jpg'] },
  { kind: 'full', files: ['10.jpg'] },
  { kind: 'bleed', files: ['11.jpg'] },
  { kind: 'full', files: ['13.jpg'] },
  { kind: 'full', files: ['14.jpg'] },
  { kind: 'full', files: ['15.jpg'] },
  { kind: 'pair', files: ['16.jpg', '17.jpg'] },
  { kind: 'full', files: ['18.jpg'] },
  { kind: 'pair', files: ['19.jpg', '20.jpg'] },
  { kind: 'full', files: ['21.jpg'] },
  { kind: 'pair', files: ['22.jpg', '23.jpg'] },
  { kind: 'full', files: ['24.jpg'] },
];

const TUNISIA_STORY: StoryRow[] = [
  { kind: 'bleed', files: ['01.jpg'] },
  { kind: 'pair', files: ['02.jpg', '03.jpg'] },
  { kind: 'full', files: ['04.jpg'] },
  { kind: 'pair', files: ['05.jpg', '06.jpg'] },
  { kind: 'bleed', files: ['07.jpg'] },
  { kind: 'pair', files: ['08.jpg', '09.jpg'] },
  { kind: 'full', files: ['10.jpg'] },
  { kind: 'pair', files: ['11.jpg', '12.jpg'] },
  { kind: 'pair', files: ['13.jpg', '14.jpg'] },
  { kind: 'pair', files: ['15.jpg', '16.jpg'] },
  { kind: 'bleed', files: ['17.jpg'] },
  { kind: 'full', files: ['18.jpg'] },
  { kind: 'pair', files: ['19.jpg', '20.jpg'] },
  { kind: 'pair', files: ['21.jpg', '22.jpg'] },
  { kind: 'full', files: ['23.jpg'] },
  { kind: 'bleed', files: ['24.jpg'] },
  { kind: 'full', files: ['25.jpg'] },
  { kind: 'pair', files: ['26.jpg', '27.jpg'] },
  { kind: 'pair', files: ['28.jpg', '29.jpg'] },
  { kind: 'full', files: ['30.jpg'] },
  { kind: 'pair', files: ['31.jpg', '32.jpg'] },
  { kind: 'pair', files: ['33.jpg', '34.jpg'] },
  { kind: 'pair', files: ['35.jpg', '36.jpg'] },
  { kind: 'bleed', files: ['37.jpg'] },
  { kind: 'full', files: ['38.jpg'] },
  { kind: 'pair', files: ['39.jpg', '40.jpg'] },
  { kind: 'full', files: ['41.jpg'] },
  { kind: 'bleed', files: ['42.jpg'] },
  { kind: 'pair', files: ['43.jpg', '44.jpg'] },
  { kind: 'pair', files: ['45.jpg', '46.jpg'] },
  { kind: 'full', files: ['47.jpg'] },
  { kind: 'pair', files: ['48.jpg', '49.jpg'] },
  { kind: 'full', files: ['50.jpg'] },
];

const storyRows: StoryRow[] | null =
  collection.layout === 'story'
    ? collection.slug === 'taiwan'
      ? TAIWAN_STORY
      : collection.slug === 'philippines'
        ? PHILIPPINES_STORY
        : collection.slug === 'tunisia'
          ? TUNISIA_STORY
          : collection.images.map((img) => ({
              kind: 'full' as const,
              files: [img.src.split('/').pop() || ''],
            }))
    : null;

const openingBleed = storyRows?.[0]?.kind === 'bleed' ? storyRows[0] : null;
const followingRows = openingBleed && storyRows ? storyRows.slice(1) : storyRows;
---
<Layout title={collection.title} active="photography">
  {openingBleed ? (
    <div class="story-open">
      <section class="page-head">
        <h1>{collection.title}</h1>
        {intro && !notebookHref && <p>{intro}</p>}
      </section>
      <div class="story-row story-row--bleed">
        {openingBleed.files.map((file) => {
          const src = `/images/photography/${collection.slug}/${file}`;
          return (
            <button type="button" class="lb-open" data-full={src}>
              <img src={src} alt="" />
            </button>
          );
        })}
      </div>
    </div>
  ) : (
    <section class="page-head">
      <h1>{collection.title}</h1>
      {intro && !notebookHref && <p>{intro}</p>}
    </section>
  )}
  {followingRows ? (
    <div class="story">
      {followingRows.map((row) => (
        <div class={`story-row story-row--${row.kind}`}>
          {row.files.map((file) => {
            const src = `/images/photography/${collection.slug}/${file}`;
            return (
              <button type="button" class="lb-open" data-full={src}>
                <img src={src} alt="" />
              </button>
            );
          })}
        </div>
      ))}
    </div>
  ) : (
    <div class="project-grid">
      {collection.images.map((img) => (
        <button type="button" class="lb-open" data-full={img.src}>
          <img src={img.src} alt={img.alt} />
        </button>
      ))}
    </div>
  )}
  {collection.quote && (
    <header
      class="quote-band"
      style={`background-image: linear-gradient(rgba(0,0,0,.35), rgba(0,0,0,.35)), url('${collection.quote.background}');`}
    >
      <p>
        {collection.quote.lines[0]}<br />
        {collection.quote.lines[1]}
      </p>
    </header>
  )}
  {notebookHref && (
    <aside class="note-preview">
      {collection.notePreview && <p>{collection.notePreview}</p>}
      <p><a href={notebookHref}>Read the note</a></p>
    </aside>
  )}
  <Lightbox />
</Layout>
