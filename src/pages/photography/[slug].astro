---
import Layout from '../../layouts/Layout.astro';
import Lightbox from '../../components/Lightbox.astro';
import { collections, type Collection } from '../../data/photography';
import { loadStoryRows, type StoryRow } from '../../data/story-rows';

export function getStaticPaths() {
  return collections.map((collection) => ({
    params: { slug: collection.slug },
    props: { collection },
  }));
}

interface Props {
  collection: Collection;
}

const { collection } = Astro.props;
const intro = collection.intro ?? collection.lede;
const notebookHref = collection.notebook ? `/notebook/${collection.notebook}` : undefined;

const storyRows: StoryRow[] | null =
  collection.layout === 'story' ? loadStoryRows(collection.slug) : null;

const openingBleed = storyRows?.[0]?.kind === 'bleed' ? storyRows[0] : null;
const followingRows = openingBleed && storyRows ? storyRows.slice(1) : storyRows;
---
<Layout title={collection.title} active="photography">
  {openingBleed ? (
    <div class="story-open">
      <section class="page-head">
        <h1>{collection.title}</h1>
        {intro && !notebookHref && <p>{intro}</p>}
      </section>
      <div class="story-row story-row--bleed">
        {openingBleed.files.map((file) => {
          const src = `/images/photography/${collection.slug}/${file}`;
          return (
            <button type="button" class="lb-open" data-full={src}>
              <img src={src} alt="" />
            </button>
          );
        })}
      </div>
    </div>
  ) : (
    <section class="page-head">
      <h1>{collection.title}</h1>
      {intro && !notebookHref && <p>{intro}</p>}
    </section>
  )}
  {followingRows ? (
    <div class="story">
      {followingRows.map((row) => (
        <div class={`story-row story-row--${row.kind}`}>
          {row.files.map((file) => {
            const src = `/images/photography/${collection.slug}/${file}`;
            return (
              <button type="button" class="lb-open" data-full={src}>
                <img src={src} alt="" />
              </button>
            );
          })}
        </div>
      ))}
    </div>
  ) : (
    <div class="project-grid">
      {collection.images.map((img) => (
        <button type="button" class="lb-open" data-full={img.src}>
          <img src={img.src} alt={img.alt} />
        </button>
      ))}
    </div>
  )}
  {collection.quote && (
    <header
      class="quote-band"
      style={`background-image: linear-gradient(rgba(0,0,0,.35), rgba(0,0,0,.35)), url('${collection.quote.background}');`}
    >
      <p>
        {collection.quote.lines[0]}<br />
        {collection.quote.lines[1]}
      </p>
    </header>
  )}
  <aside class="photo-look" id="look">
    <p>These photos are here to look at. Please ask before using them.</p>
    <a class="photo-look-ask" href="mailto:benculpin@gmail.com?subject=Photography">Ask</a>
  </aside>
  {notebookHref && (
    <aside class="note-preview">
      {collection.notePreview && <p>{collection.notePreview}</p>}
      <p><a href={notebookHref}>Read the note</a></p>
    </aside>
  )}
  <Lightbox />
</Layout>

<style>
  /* Story and project pages only. The photography landing keeps the look line
     beside the title (see index.astro) — do not centre it there. */
  .photo-look {
    justify-content: center;
    text-align: center;
  }
</style>
