---
import Layout from '../../layouts/Layout.astro';
import Lightbox from '../../components/Lightbox.astro';
import { collections, type Collection } from '../../data/photography';

export function getStaticPaths() {
  return collections.map((collection) => ({
    params: { slug: collection.slug },
    props: { collection },
  }));
}

interface Props {
  collection: Collection;
}

const { collection } = Astro.props;
const intro = collection.intro ?? collection.lede;
const notebookHref = collection.notebook ? `/notebook/${collection.notebook}` : undefined;

type StoryRow = { kind: 'full' | 'pair' | 'bleed'; files: string[] };

const TAIWAN_STORY: StoryRow[] = [
  { kind: 'bleed', files: ['03.jpg'] },
  { kind: 'pair', files: ['01.jpg', '02.jpg'] },
  { kind: 'pair', files: ['04.jpg', '07.jpg'] },
  { kind: 'pair', files: ['05.jpg', '06.jpg'] },
  { kind: 'pair', files: ['08.jpg', '13.jpg'] },
  { kind: 'bleed', files: ['09.jpg'] },
  { kind: 'pair', files: ['10.jpg', '11.jpg'] },
  { kind: 'full', files: ['12.jpg'] },
  { kind: 'pair', files: ['14.jpg', '19.jpg'] },
  { kind: 'full', files: ['16.jpg'] },
  { kind: 'pair', files: ['15.jpg', '17.jpg'] },
  { kind: 'full', files: ['18.jpg'] },
  { kind: 'pair', files: ['20.jpg', '21.jpg'] },
];

const storyRows: StoryRow[] | null =
  collection.layout === 'story'
    ? collection.slug === 'taiwan'
      ? TAIWAN_STORY
      : collection.images.map((img) => ({
          kind: 'full' as const,
          files: [img.src.split('/').pop() || ''],
        }))
    : null;
---
<Layout title={collection.title} active="photography">
  <section class="page-head">
    <h1>{collection.title}</h1>
    {intro && !notebookHref && <p>{intro}</p>}
  </section>
  {storyRows ? (
    <div class="story">
      {storyRows.map((row) => (
        <div class={`story-row story-row--${row.kind}`}>
          {row.files.map((file) => {
            const src = `/images/photography/${collection.slug}/${file}`;
            return (
              <button type="button" class="lb-open" data-full={src}>
                <img src={src} alt="" />
              </button>
            );
          })}
        </div>
      ))}
    </div>
  ) : (
    <div class="project-grid">
      {collection.images.map((img) => (
        <button type="button" class="lb-open" data-full={img.src}>
          <img src={img.src} alt={img.alt} />
        </button>
      ))}
    </div>
  )}
  {collection.quote && (
    <header
      class="quote-band"
      style={`background-image: linear-gradient(rgba(0,0,0,.35), rgba(0,0,0,.35)), url('${collection.quote.background}');`}
    >
      <p>
        {collection.quote.lines[0]}<br />
        {collection.quote.lines[1]}
      </p>
    </header>
  )}
  {notebookHref && (
    <aside class="note-preview">
      {collection.notePreview && <p>{collection.notePreview}</p>}
      <p><a href={notebookHref}>Read the note</a></p>
    </aside>
  )}
  <Lightbox />
</Layout>
