---
import Layout from '../../layouts/Layout.astro';
import { collections } from '../../data/photography';
---
<Layout title="Photography" active="photography">
  <section class="page-head">
    <h1>Photography</h1>
  </section>
  <div class="collection-list">
    {collections.map((c) => (
      <a class="collection" href={c.href}>
        <img src={c.cover} alt="" />
        <div>
          <h2>{c.title}</h2>
          {c.lede && <p>{c.lede}</p>}
        </div>
      </a>
    ))}
  </div>
</Layout>
